# --- Vercel project env vars (web app + api/*.js) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_APP_URL=
FISH_API_KEY=
GROQ_API_KEY=
FAL_KEY=
RELAY_WS_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SOCIAL_RELAY_URL=
SOCIAL_RELAY_INTERNAL_SECRET=
# Optional separate shared secret for web app -> call relay Direct Voice routes.
# If unset, SOCIAL_RELAY_INTERNAL_SECRET is reused.
DIRECT_BRIDGE_SECRET=

# --- Relay server env vars (server/relay.js, deployed separately, e.g. Render) ---
PORT=8080
GROQ_API_KEY=
FAL_KEY=
FISH_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Caller Mode / voice changer. VOICE_CHANGER_URL points at a running
# w-okada/voice-changer VCClient server (RVC model loaded in a slot), e.g.
# http://10.0.0.4:18888 or an https tunnel to it. The relay calls /info,
# /update_settings and /test on that server. Use the TLS flag only for a
# self-signed w-okada HTTPS endpoint you control.
DIRECT_BRIDGE_SECRET=
VOICE_CHANGER_URL=
VOICE_CHANGER_SAMPLE_RATE=48000
VOICE_CHANGER_TIMEOUT_MS=2500
VOICE_CHANGER_TLS_INSECURE=false

# --- Social calling relay env vars (server-social/social-relay.js, its own
# Render service — see server-social/README-social.md) ---
PORT=8081
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SOCIAL_RELAY_INTERNAL_SECRET=
SOCIAL_SESSION_ENC_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
WHATSAPP_CALLING_ENABLED=false
