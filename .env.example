# --- Vercel project env vars (web app + api/*.js) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_APP_URL=
FISH_API_KEY=
# Primary conversation LLM (GPT Luna via OpenAI's Chat Completions API).
# Groq support was REMOVED entirely — no GROQ_API_KEY, no groq fallback.
# Optional second endpoint: fal OpenRouter (proxies openai/gpt-4o-mini).
LLM_PROVIDER=luna
LLM_MODEL=gpt-6-luna
LLM_BASE_URL=https://api.openai.com/v1
# Speech-to-text (browser voice input + Twilio relays). Defaults to
# gpt-4o-mini-transcribe; set to whisper-1 to use the fallback model.
STT_MODEL=
LUNA_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
RELAY_WS_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
SOCIAL_RELAY_URL=
SOCIAL_RELAY_INTERNAL_SECRET=

# --- Relay server env vars (server/patter-relay.js or server/relay.js, deployed on Render) ---
PORT=8080
LLM_PROVIDER=luna
LLM_MODEL=gpt-6-luna
LUNA_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
FISH_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Assistant service env vars (pipecat-service/, deployed as its own Render
# Web Service — see docs/ASSISTANT-DEPLOYMENT.md and
# pipecat-service/render.yaml) ---
#
# This service runs the Pipecat pipeline. It is reached only by the PHP relay
# (mp-relay) over the ACAF WebSocket bridge, never by the browser. The PHP
# relay talks to it via ASSISTANT_BRIDGE_URL below.
PORT=
ASSISTANT_BRIDGE_SECRET=
# STT is OpenAI only (gpt-4o-mini-transcribe by default; whisper-1 via
# ASSISTANT_STT_MODEL=whisper-1). "mock" for local runs. Groq was removed.
ASSISTANT_STT_PROVIDER=openai
# "luna" (gpt-6-luna) or "openai" — both talk to api.openai.com; "mock" for
# local runs. Groq is not a valid value any more.
ASSISTANT_LLM_PROVIDER=luna
ASSISTANT_TTS_PROVIDER=fish
ASSISTANT_STT_MODEL=
ASSISTANT_LLM_MODEL=gpt-6-luna
ASSISTANT_LLM_BASE_URL=
LUNA_API_KEY=
OPENAI_API_KEY=
ASSISTANT_LLM_TEMPERATURE=0.7
ASSISTANT_LLM_MAX_TOKENS=200
ASSISTANT_TTS_VOICE_ID=
ASSISTANT_TTS_MODEL=
ASSISTANT_BRIDGE_SAMPLE_RATE=16000
ASSISTANT_IDLE_TIMEOUT_SECS=30
ASSISTANT_HEARTBEAT_INTERVAL_SECS=10
ASSISTANT_OUTBOUND_QUEUE_MAX_FRAMES=100
ASSISTANT_MAX_CALL_SECONDS=1800
ASSISTANT_MAX_SILENT_TURNS=3
ASSISTANT_GREETING=
ASSISTANT_SYSTEM_PROMPT=
# Off by default. Storing memory across calls is user data, so it is opt-in.
# (Retrieving memories into the call prompt requires SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY below; the call-context resolver and live
# transcript writes use those creds regardless of this flag.)
ASSISTANT_ENABLE_PERSISTENT_MEMORY=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# How long to wait at call start for the app's calls row (written just
# before the carrier dials). Default 20s.
ASSISTANT_CONTEXT_TIMEOUT_SECS=20
# App base URL: lets the service report a call's end through
# /api/social-calling when the carrier's own callback never arrived
# (this is what triggers the shared summary for such calls).
PUBLIC_APP_URL=
# Optional noise-guidance prompt for the transcription API.
ASSISTANT_STT_PROMPT=
# Local/mocked mode: no provider keys, no network calls, no real calls placed.
# Used by the test suite and for local development.
ASSISTANT_MOCK_MODE=false

# --- mp-relay env vars (multipurps/mp-relay, separate repo, Render) ---
# Referenced by lib/mpRelayClient.js but previously missing from this file.
MP_RELAY_URL=
MP_RELAY_INTERNAL_SECRET=
# The ACAF bridge endpoint the PHP relay dials, e.g. wss://audio-call-assistant.onrender.com/stream
ASSISTANT_BRIDGE_URL=
# Postgres (Supabase) session storage used by MadelineProto's Postgres backend.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# --- WaCalls (WhatsApp calling) env vars ---
# Referenced by lib/wacallsClient.js but previously missing from this file.
WACALLS_RELAY_URL=
WACALLS_INTERNAL_SECRET=

# --- Social calling relay env vars (server-social/social-relay.js, its own
# Render service — see server-social/README-social.md) ---
PORT=8081
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SOCIAL_RELAY_INTERNAL_SECRET=
SOCIAL_SESSION_ENC_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
WHATSAPP_CALLING_ENABLED=false
