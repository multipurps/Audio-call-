{
  "functions": {
    "api/assistant.js": {
      "maxDuration": 60
    },
    "api/social-calling.js": {
      "maxDuration": 60
    },
    "api/calls.js": {
      "maxDuration": 60
    },
    "api/calls-status.js": {
      "maxDuration": 60
    },
    "api/memories.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/bachs-webhook",
      "dest": "/api/referrals?action=webhook"
    },
    {
      "src": "/landing\\.html",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      },
      "dest": "/home.html"
    },
    {
      "src": "/(index\\.html|admin|admin/|admin/index\\.html)",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/assets/call/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    }
  ]
}
